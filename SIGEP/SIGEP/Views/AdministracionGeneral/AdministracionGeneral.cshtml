@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewBag.Title = "Administración General";

    var tab = (string)(ViewBag.Tab ?? "usuarios");
    var clsUsuarios = tab == "usuarios" ? "" : "d-none";
    var clsEspecialidades = tab == "especialidades" ? "" : "d-none";
    var clsSecciones = tab == "secciones" ? "" : "d-none";
}

<section class="vacantes-wrapper container">
    <h2 class="vacantes-titulo titulo-principal">Administración General</h2>

    <div class="row gy-3 mb-4">
        <div class="col-md-4">
            <button class="btn w-100 py-3 rounded-4" data-tab="usuarios">
                <i class="bi bi-people me-2"></i> Gestión de Usuarios
            </button>
        </div>
        <div class="col-md-4">
            <button class="btn w-100 py-3 rounded-4" data-tab="especialidades">
                <i class="bi bi-wrench me-2"></i> Gestión de Especialidades
            </button>
        </div>
        <div class="col-md-4">
            <button class="btn w-100 py-3 rounded-4" data-tab="secciones">
                <i class="bi bi-layers me-2"></i> Gestión de Secciones
            </button>
        </div>
    </div>

    <!-- USUARIOS -->
    <div id="usuarios" class="seccion-adm @clsUsuarios">
        <h3 class="text-center">Gestión de Usuarios</h3>
        <div class="row mb-3">
            <div class="col-md-4">
                <label for="filtroRol" class="form-label">Filtrar por rol:</label>
                <select id="filtroRol" class="form-control">
                    <option value="">Todos</option>
                    <option>Estudiante</option>
                    <option>Profesor</option>
                    <option>Egresado</option>
                    <option>Coordinador</option>
                </select>
            </div>
        </div>
        <div class="table-container">
            <table id="tablaUsuarios" class="display responsive nowrap w-100">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Cédula</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                        <th class="d-none">EstadoOrden</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- ESPECIALIDADES -->
    <div id="especialidades" class="seccion-adm @clsEspecialidades">
        <h3 class="text-center">Especialidades Registradas</h3>
        <button type="button" class="btn mb-3" data-bs-toggle="modal" data-bs-target="#modalCrearEspecialidad">
            + Nueva Especialidad
        </button>
        <div class="table-container">
            <table id="tablaEspecialidades" class="display responsive nowrap w-100">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Acciones</th>
                        <th class="d-none">EstadoOrden</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    <!-- SECCIONES -->
    <div id="secciones" class="seccion-adm @clsSecciones">
        <h3 class="text-center">Secciones Registradas</h3>
        <button type="button" class="btn mb-3" data-bs-toggle="modal" data-bs-target="#modalCrearSeccion">
            + Nueva Sección
        </button>
        <div class="table-container">
            <table id="tablaSecciones" class="display responsive nowrap w-100">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Acciones</th>
                        <th class="d-none">EstadoOrden</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</section>

<!-- MODALES -->
<div class="modal fade" id="modalEditarRolUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formEditarRolUsuario">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Rol de Usuario</h5>
                    <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Cerrar">×</button>
                </div>
                <div class="modal-body">
                    <p class="mb-1"><strong>Nombre:</strong> <span id="rolNombre"></span></p>
                    <p class="mb-1"><strong>Cédula:</strong> <span id="rolCedula"></span></p>
                    <p class="mb-3"><strong>Email:</strong> <span id="rolEmail"></span></p>
                    <label class="form-label">Rol *</label>
                    <select id="rol" name="rol" required class="form-control">
                        <option value="">-- Seleccione --</option>
                        <option>Profesor</option>
                        <option>Estudiante</option>
                        <option>Egresado</option>
                        <option>Coordinador</option>
                    </select>
                    <input type="hidden" id="usuarioId" name="usuarioId" />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCrearEspecialidad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formCrearEspecialidad">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar Nueva Especialidad</h5>
                    <button type="button" class="btn" data-bs-dismiss="modal">×</button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Nombre *</label>
                    <input type="text" id="nombreEspecialidad" name="nombreEspecialidad" required class="form-control" />
                    <label class="form-label">Descripción (no se guarda)</label>
                    <textarea id="descripcionEspecialidad" name="descripcionEspecialidad" class="form-control"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditarEspecialidad" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formEditarEspecialidad">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Especialidad</h5>
                    <button type="button" class="btn" data-bs-dismiss="modal">×</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editarIdEspecialidad" name="id" />
                    <label class="form-label">Nombre *</label>
                    <input type="text" id="editarNombreEspecialidad" name="nombreEspecialidad" required class="form-control" />
                    <label class="form-label">Descripción (no se guarda)</label>
                    <textarea id="editarDescripcionEspecialidad" name="descripcionEspecialidad" class="form-control"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCrearSeccion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formCrearSeccion">
                <div class="modal-header">
                    <h5 class="modal-title">Registrar Nueva Sección</h5>
                    <button type="button" class="btn" data-bs-dismiss="modal">×</button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Nombre de la sección *</label>
                    <input type="text" id="nombreSeccion" name="nombreSeccion" required class="form-control" />
                    <label class="form-label">Descripción (no se guarda)</label>
                    <textarea id="descripcionSeccion" name="descripcionSeccion" class="form-control"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEditarSeccion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formEditarSeccion">
                <div class="modal-header">
                    <h5 class="modal-title">Editar Sección</h5>
                    <button type="button" class="btn" data-bs-dismiss="modal">×</button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editarIdSeccion" name="id" />
                    <label class="form-label">Nombre de la sección *</label>
                    <input type="text" id="editarNombreSeccion" name="nombreSeccion" required class="form-control" />
                    <label class="form-label">Descripción (no se guarda)</label>
                    <textarea id="editarDescripcionSeccion" name="descripcionSeccion" class="form-control"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script>window.__TAB_INICIAL__='@tab';</script>
    <script src="~/Scripts/administracion-general.js"></script>
}
