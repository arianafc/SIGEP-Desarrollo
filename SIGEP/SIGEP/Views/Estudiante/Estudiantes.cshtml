@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewBag.Title = "Listado de Estudiantes";
    var rol = Session["Rol"] != null ? Session["Rol"].ToString() : "";
}

<h2 class="vacantes-titulo titulo-principal d-flex justify-content-center align-items-center">
    @(rol == "Coordinador" ? "Estudiantes" : "Mis Estudiantes") @DateTime.Now.Year
</h2>

<div class="vacantes-titulo titulo-principal d-flex justify-content-between mb-0 align-items-center">
    @if (rol == "Coordinador")
    {
        <button type="button" class="btn-cta btn-nuevo mb-0" data-bs-toggle="modal" data-bs-target="#modalRegistrarEstudiante">
            + Registrar
        </button>
    }
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filtroDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-filter"></i> Filtros
        </button>
        <div class="dropdown-menu p-3" style="min-width: 300px;">
            <div class="mb-2">
                <label>Estado académfico</label>
                <select id="filtroEstado" class="form-control">
                    <option value="">Todos</option>
                    @foreach (var estado in ViewBag.Estados as List<SelectListItem>)
                    {
                        <option value="@estado.Text">@estado.Text</option>
                    }
                </select>
            </div>
            <div>
                <label>Especialidad</label>
                <select id="filtroEspecialidad" class="form-control">
                    <option value="">Todas</option>
                    @foreach (var esp in ViewBag.Especialidades as List<SelectListItem>)
                    {
                        <option value="@esp.Value">@esp.Text</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

<div class="card rounded-5 p-3">
    <table id="tablaEstudiantes" class="display responsive nowrap w-100">
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombre Completo</th>
                <th>Especialidad</th>
                <th>Teléfono</th>
                <th>Estado Académico</th>
                <th>Estado de Práctica</th>
                <th>Acciones</th>
            </tr>
        </thead>
    </table>
</div>

<!-- MODAL PERFIL -->
<div class="modal fade" id="modalPerfil" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; background-color: #F2F2F2; color: #2D594D;">
            <div class="modal-header" style="background-color: #2D594D; color: white;">
                <h5 class="modal-title">Perfil del Estudiante</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4" id="perfilBody">
                <div class="text-center">
                    <span class="text-muted">Cargando datos...</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn CerrarModal" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ACTUALIZAR ESTADO -->
<div class="modal fade" id="modalActualizarEstado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content" style="border-radius: 12px; background-color: #F2F2F2; color: #2D594D;">
                <div class="modal-header" style="background-color: #2D594D; color: white;">
                    <h5 class="modal-title">Actualizar Estado Académico</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4">
                    <input type="hidden" id="hdnIdUsuario" />
                    <div class="form-group mb-3">
                        <label for="ddlNuevoEstado">Seleccione nuevo estado:</label>
                        <select id="ddlNuevoEstado" class="form-select OpcionesVacantes w-100" style="font-size:14px">
                            @foreach (var estado in ViewBag.Estados as List<SelectListItem>)
                            {
                                <option value="@estado.Value">@estado.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer px-4">
                    <button type="button" class="btn CerrarModal" id="btnConfirmarActualizar">
                        <i class="fas fa-sync-alt"></i> Actualizar
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>












@section scripts {
    <script>
    $(document).ready(function () {
        var table = $('#tablaEstudiantes').DataTable({
            ajax: {
                url: '@Url.Action("GetEstudiantes", "Estudiante")',
                dataSrc: 'data'
            },
            columns: [
                { data: 'Cedula' },
                { data: 'NombreCompleto' },
                { data: 'EspecialidadNombre' },
                { data: 'Telefono' },
                {
                    data: 'EstadoNombre',   // Estado Académico
                    render: function (data) {
                        if (!data) {
                            return `<span class="badge badge-no-asignada">Sin Estado</span>`;
                        }

                        switch (data.toLowerCase()) {
                            case "activo":
                                return `<span class="badge-activo">${data}</span>`;
                            case "inactivo":
                                return `<span class="badge-inactivo">${data}</span>`;
                            case "aprobada":
                            case "aprobado":
                                return `<span class="badge-aprobado">${data}</span>`;
                            case "rezagado":
                                return `<span class="badge-rezagado">${data}</span>`;
                            default:
                                return `<span class="badge-no-asignada">${data}</span>`;
                        }

                    }
                },
                {
                    data: 'EstadoPractica',
                    render: function (data) {
                        if (!data) {
                            return `<span class="badge badge-default">Sin práctica</span>`;
                        }

                        let clase = "";
                        switch (data) {
                            case "En progreso": clase = "badge-en-progreso"; break;
                            case "Asignada": clase = "badge-asignada"; break;
                            case "Rechazada": clase = "badge-rechazada"; break;
                            case "En curso": clase = "badge-en-curso"; break;
                            case "Finalizada": clase = "badge-finalizada"; break;
                            case "Aprobada": clase = "badge-aprobada"; break;
                            case "Retirada": clase = "badge-retirada"; break;
                            case "No Asignada": clase = "badge-no-asignada"; break;
                            default: clase = "badge-default"; break;
                        }

                        return `<span class="badge ${clase}">${data}</span>`;
                    }
                },
                {
                    data: 'IdUsuario',
                    render: function (data, type, row) {
                        return `
                            <button class="btn bg-transparent verPerfil" data-id="${data}" style="color:#2d594d">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn bg-transparent btn-actualizar-estado" data-id="${data}" data-estado="${row.IdEstado}" style="color:#2d594d">
                                <i class="fas fa-sync-alt"></i>
                            </button>`;
                    }
                }
            ],
            columnDefs: [
                { targets: -1, orderable: false, searchable: false, width: "100px" }
            ]
        });

        $('#filtroEstado, #filtroEspecialidad').on('change', function () {
            table.ajax.reload();
        });

        $('#tablaEstudiantes').on('click', '.verPerfil', function () {
            var id = $(this).data('id');
            $('#perfilBody').html('<div class="text-center"><span class="text-muted">Cargando datos...</span></div>');
            $.get('@Url.Action("Detalle", "Estudiante")/' + id, function (data) {
                $('#perfilBody').html(data);
                $('#modalPerfil').modal('show');
            });
        });

        $(document).on("click", ".btn-actualizar-estado", function () {
            var idUsuario = $(this).data("id");
            var estadoActual = $(this).data("estado");
            $("#hdnIdUsuario").val(idUsuario);
            $("#ddlNuevoEstado").val(estadoActual);
            $("#modalActualizarEstado").modal("show");
        });

        $("#btnConfirmarActualizar").click(function () {
            var idUsuario = $("#hdnIdUsuario").val();
            var nuevoEstado = $("#ddlNuevoEstado").val();

            $.ajax({
                url: '@Url.Action("ActualizarEstado", "Estudiante")',
                type: 'POST',
                data: { idUsuario: idUsuario, nuevoEstadoId: nuevoEstado },
                success: function (res) {
                    if (res.success) {
                        $("#modalActualizarEstado").modal("hide");
                        table.ajax.reload();
                        Swal.fire("Éxito", res.message, "success");
                    } else {
                        Swal.fire("Error", res.message, "error");
                    }
                }
            });
        });
    });
    </script>
}
