@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewBag.Title = "Listado de Estudiantes";
}

<h2 class="vacantes-titulo titulo-principal d-flex justify-content-between align-items-center">
    Proceso de Prácticas @DateTime.Now.Year
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filtroDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-filter"></i>
        </button>
        <div class="dropdown-menu p-3" style="min-width: 300px;">
            <div class="mb-2">
                <label class="Filtros">Estado académico</label>
                <select id="filtroEstadoAcademico" class="form-control">
                    <option value="">Todos</option>
                    <option value="Aprobado">Aprobado</option>
                    <option value="Rezagado">Rezagado</option>
                </select>
            </div>
            <div class="mb-2">
                <label>Estado de práctica (global)</label>
                <select id="filtroPractica" class="form-control">
                    <option value="">Todos</option>
                    <option value="Asignada">Asignada</option>
                    <option value="Con Procesos Activos">Con Procesos Activos</option>
                    <option value="Sin Procesos Activos">Sin Procesos Activos</option>
                </select>
            </div>
            <div>
                <label>Especialidad</label>
                <input type="text" id="filtroEspecialidad" class="form-control" placeholder="Filtrar por especialidad" />
            </div>
        </div>
    </div>
</h2>

<!-- 🔹 NUEVOS BOTONES para iniciar y finalizar prácticas -->
<div class="d-flex justify-content-end mb-3">
    <button id="btnIniciarPracticas" class="btn btn-success me-2">
        <i class="fas fa-play"></i> Iniciar Prácticas
    </button>
    <button id="btnFinalizarPracticas" class="btn btn-danger">
        <i class="fas fa-stop"></i> Finalizar Prácticas
    </button>
</div>

<div class="card rounded-5 p-3">
    <table id="miTabla" class="display responsive nowrap w-100">
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombre</th>
                <th>Especialidad</th>
                <th>Teléfono</th>
                <th>Estado de Postulación</th>
                <th>Empresa</th>
                <th>Tipo</th>
                <th style="width:140px;">Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

@section scripts {
    <script>
        $(function () {

            var table = $('#miTabla').DataTable({
                responsive: true,
                processing: true,
                serverSide: false, // usamos client-side con un solo fetch
                ajax: {
                    url: '@Url.Action("ListarEstudiantesJson", "Practicas")',
                    type: 'GET',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'Cedula' },
                    { data: 'Nombre' },
                    { data: 'Especialidad' },
                    { data: 'Telefono',
                      render: function (d) { return d || '—'; } },
                    { data: 'EstadoPostulacion',
                      render: function (d) {
                          if (!d) return '—';
                          var cls = (d === 'Asignada') ? 'badge-asignada' :
                                    (d === 'Con Procesos Activos') ? 'badge-en-proceso' : 'badge-no-asignada';
                          return '<span class="badge ' + cls + ' badge-estado-academico">' + d + '</span>';
                      }},
                    { data: 'Empresa', render: d => d || '—' },
                    { data: 'Tipo',
                      render: function (d) {
                          if (!d || d === '—') return '<span class="badge badge-secondary">—</span>';
                          var cls = (d.toLowerCase().indexOf('asign') >= 0) ? 'badge-asignada' : 'badge-en-proceso';
                          return '<span class="badge ' + cls + '">' + d + '</span>';
                      }},
                    {
                        data: null,
                        orderable: false,
                        render: function (row) {
                            var disabledVer = (!row.IdVacanteUltima || !row.IdUsuario) ? 'disabled' : '';

                            return `
                              <a href="javascript:void(0);" class="btn-ver ${disabledVer}"
                                 data-idvacante="${row.IdVacanteUltima || ''}" data-idusuario="${row.IdUsuario}"
                                 style="color:#2d594d; text-decoration:none; margin-right:6px;">
                                 <i class="fas fa-eye"></i>
                              </a>`;
                        }


                    }
                ],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                }
            });

            // === Filtros ===
            $('#filtroPractica').on('change', function () {
                table.column(4).search(this.value).draw();
            });

            $('#filtroEspecialidad').on('keyup', function () {
                table.column(2).search(this.value).draw();
            });

            // El "Estado académico" realmente vive en UsuariosTB.IdEstado; como no lo mostramos en tabla,
            // abrimos un selector y disparamos POST a la API.
            $(document).on('click', '.btn-cambiar-estado', function () {
                var idUsuario = $(this).data('idusuario');
                var nombre = $(this).data('nombre');

                Swal.fire({
                    title: 'Estado académico de ' + nombre,
                    input: 'select',
                    inputOptions: {
                        'Aprobado': 'Aprobado',
                        'Rezagado': 'Rezagado'
                    },
                    inputPlaceholder: 'Selecciona un estado',
                    showCancelButton: true,
                    confirmButtonText: 'Actualizar',
                    cancelButtonText: 'Cancelar'
                }).then(function (res) {
                    if (res.isConfirmed && res.value) {
                        $.post('@Url.Action("CambiarEstadoAcademico","Practicas")', {
                            idUsuario: idUsuario,
                            nuevoEstado: res.value
                        }).done(function (r) {
                            if (r.ok) {
                                Swal.fire('Listo', r.msg, 'success');
                                table.ajax.reload(null, false);
                            } else {
                                Swal.fire('Ups', r.msg || 'No se pudo actualizar', 'error');
                            }
                        }).fail(function () {
                            Swal.fire('Error', 'No se pudo actualizar', 'error');
                        });
                    }
                });
            });

            // Ver visualización (usa SP ObtenerVisualizacionPracticaSP)
            $(document).on('click', '.btn-ver', function (e) {
                e.preventDefault();
                var idVacante = $(this).data('idvacante');
                var idUsuario = $(this).data('idusuario');
                if (!idVacante || !idUsuario) return;

                // Abrir en nueva pestaña (o podrías usar un modal con Partial)
                var url = '@Url.Action("VisualizacionPostulacion","Practicas")' + '?idVacante=' + idVacante + '&idUsuario=' + idUsuario;
                window.open(url, '_blank');
            });

            // Desasignar práctica (usa SP ActualizarEstadoPracticaSP -> cambia a "Retirada"/"Cancelada")
            $(document).on('click', '.btn-desasignar', function () {
                var idPractica = $(this).data('idpractica');
                var nombre = $(this).data('nombre');

                if (!idPractica) return;

                Swal.fire({
                    title: 'Desasignar práctica',
                    html: '¿Deseas desasignar a <b>' + nombre + '</b>?<br/><small>Se cambiará el estado de la práctica a Retirada/Cancelada.</small>',
                    input: 'text',
                    inputLabel: 'Comentario (opcional)',
                    inputPlaceholder: 'Motivo o nota...',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, desasignar',
                    cancelButtonText: 'Cancelar'
                }).then(function (r) {
                    if (r.isConfirmed) {
                        $.post('@Url.Action("DesasignarPractica", "Practicas")', {
                            idPractica: idPractica,
                            comentario: r.value || ''
                        }).done(function (res) {
                            if (res.ok) {
                                Swal.fire('Hecho', res.msg, 'success');
                                table.ajax.reload(null, false);
                            } else {
                                Swal.fire('Ups', res.msg || 'No se pudo desasignar', 'error');
                            }
                        }).fail(function () {
                            Swal.fire('Error', 'No se pudo desasignar', 'error');
                        });
                    }
                });
            });

             // === INICIAR PRÁCTICAS ===
            $('#btnIniciarPracticas').click(function () {
                Swal.fire({
                    title: '¿Iniciar todas las prácticas?',
                    html: 'Las prácticas <b>Asignadas</b> pasarán a <b>En Curso</b>.<br>Las demás se marcarán como <b>Retirada</b> con comentario automático.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, iniciar',
                    cancelButtonText: 'Cancelar'
                }).then(res => {
                    if (res.isConfirmed) {
                        $.post('@Url.Action("IniciarPracticas", "Practicas")', function (r) {
                            if (r.ok) {
                                Swal.fire('Hecho', r.message, 'success');
                                table.ajax.reload(null, false);
                            } else {
                                Swal.fire('Error', r.message, 'error');
                            }
                        }).fail(() => Swal.fire('Error', 'No se pudo iniciar el proceso.', 'error'));
                    }
                });
            });

            // === FINALIZAR PRÁCTICAS ===
            $('#btnFinalizarPracticas').click(function () {
                Swal.fire({
                    title: '¿Finalizar todas las prácticas?',
                    html: 'Las prácticas en estado <b>Aprobada</b> o <b>Rezagado</b> se marcarán como <b>Finalizadas</b>.<br>Las vacantes serán archivadas y los estudiantes aprobados pasarán a <b>Egresado</b>.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, finalizar',
                    cancelButtonText: 'Cancelar'
                }).then(res => {
                    if (res.isConfirmed) {
                        $.post('@Url.Action("FinalizarPracticas", "Practicas")', function (r) {
                            if (r.ok) {
                                Swal.fire('Hecho', r.message, 'success');
                                table.ajax.reload(null, false);
                            } else {
                                Swal.fire('Error', r.message, 'error');
                            }
                        }).fail(() => Swal.fire('Error', 'No se pudo finalizar el proceso.', 'error'));
                    }
                });
            });


        });
    </script>
    <style>
        /* Badges rápidas */
        .badge-asignada {
            background-color: #2d594d;
            color: #fff;
        }

        .badge-en-proceso {
            background-color: #ffc107;
            color: #000;
        }

        .badge-no-asignada {
            background-color: #dc3545;
            color: #fff;
        }

        .badge-secondary {
            background-color: #6c757d;
            color: #fff;
        }
    </style>
}
