@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewBag.Title = "Listado de Estudiantes";
    var idRol = Session["IdRol"] != null ? Convert.ToInt32(Session["IdRol"]) : 0;
}

@section styles {
    <link href="~/Content/PracticasCoordinador.css" rel="stylesheet" />
}

<h2 class="vacantes-titulo titulo-principal text-center">
    Proceso de Prácticas @DateTime.Now.Year
</h2>

<!-- FILTROS + BOTONES -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <!-- 🔸 FILTROS -->
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filtroDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-filter"></i>
        </button>
        <div class="dropdown-menu p-3" style="min-width: 300px;">
            <div class="mb-2">
                <label class="Filtros">Estado académico</label>
                <select id="filtroEstadoAcademico" class="form-control">
                    <option value="">Todos</option>
                    <option value="Aprobado">Aprobado</option>
                    <option value="Rezagado">Rezagado</option>
                </select>
            </div>
            <div class="mb-2">
                <label>Estado de práctica (global)</label>
                <select id="filtroPractica" class="form-control">
                    <option value="">Todos</option>
                    <option value="Asignada">Asignada</option>
                    <option value="Con Procesos Activos">Con Procesos Activos</option>
                    <option value="Sin Procesos Activos">Sin Procesos Activos</option>
                </select>
            </div>
            <div>
                <label>Especialidad</label>
                <select id="filtroEspecialidad" class="form-control">
                    <option value="">Todas</option>
                    @foreach (var esp in ViewBag.Especialidades as List<SelectListItem>)
                    {
                        <option value="@esp.Text">@esp.Text</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- BOTONES DE PROCESO -->
    @if (idRol == 2)
    {
        <div>
            <button id="btnIniciarPracticas" class="btn-verde-personalizado me-2">
                <i class="fas fa-play"></i> Iniciar Prácticas
            </button>
            <button id="btnFinalizarPracticas" class="btn-verde-claro">
                <i class="fas fa-stop"></i> Finalizar Prácticas
            </button>
        </div>
    }
</div>

<!-- TABLA -->
<div class="card rounded-5 p-3">
    <table id="miTabla" class="display responsive nowrap w-100">
        <thead>
            <tr>
                <th>Cédula</th>
                <th>Nombre</th>
                <th>Especialidad</th>
                <th>Teléfono</th>
                <th>Estado de Postulación</th>
                <th>Empresa</th>
                <th>Tipo</th>
                <th style="width:140px;">Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<!-- Modal de asignación -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-labelledby="modalAsignarLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; background-color: #F2F2F2; color: #2D594D;">
            <div class="modal-header" style="background-color: #2D594D; color: white;">
                <h5 class="modal-title">Asignar Estudiante a Vacante</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body px-4">
                <div class="mb-4 card rounded-5 p-3">
                    <h5 class="section-title mb-3">Vacantes disponibles</h5>
                    <table id="miTablaAsignar" class="display responsive nowrap w-100">
                        <thead>
                            <tr>
                                <th>Vacante</th>
                                <th>Empresa</th>
                                <th>Especialidad</th>
                                <th>Cupos</th>
                                <th>Ocupados</th>
                                <th>Estado práctica</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer px-4">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Script principal del módulo -->
    <script src="~/Scripts/Practicas/PracticasCoordinador.js"></script>

    <script>
    // Función para recargar la tabla principal ===
    function recargarTabla() {
        if ($.fn.dataTable.isDataTable('#miTabla')) {
            const table = $('#miTabla').DataTable();
            //table.ajax.reload(null, false);
            console.log("🔄 Tabla de prácticas recargada correctamente");
        }
    }

    // Control de recarga y eventos de visibilidad ===
    $(document).ready(function () {
        if (performance.getEntriesByType("navigation")[0]?.type === "back_forward") {
            console.log("📦 Navegación desde caché detectada → forzando recarga completa");
            location.reload(true);
        } else {
            recargarTabla();
        }

        document.addEventListener("visibilitychange", function () {
            if (document.visibilityState === "visible") {
                recargarTabla();
            }
        });

        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                console.log("♻️ Página cargada desde caché → recargando");
                location.reload(true);
            } else {
                recargarTabla();
            }
        });

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('refresh') === 'true') {
            recargarTabla();
        }
    });

    // Configuración global del módulo de prácticas ===
    window.PracticasCfg = {
        urls: {
            obtenerEstudiantesPracticas: '@Url.Action("ObtenerEstudiantesPracticas", "Practicas")',
            obtenerVacantesAsignar: '@Url.Action("ObtenerVacantesAsignar", "Practicas")',
            asignarEstudiante: '@Url.Action("AsignarEstudiante", "Practicas")',
            desasignarPractica: '@Url.Action("DesasignarPractica", "Practicas")',
            retirarEstudiante: '@Url.Action("RetirarEstudiante", "Practicas")'
        },
        rol: @idRol,
        idUsuarioSesion: @(Session["IdUsuario"] ?? 0)
    };
    </script>
}