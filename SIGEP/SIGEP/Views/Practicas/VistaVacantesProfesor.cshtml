@{
    ViewBag.Title = "Vacantes - Profesor";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

<section class="vacantes-wrapper vacantes-profesor">
    <h2 class="vacantes-titulo titulo-principal">Vacantes Disponibles</h2>

    <div class="vacantes-titulo titulo-principal d-flex justify-content-between mb-3 align-items-center">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filtroDropdown"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-filter"></i>
            </button>
            <div class="dropdown-menu p-3" style="min-width: 300px;">
                <div class="mb-2">
                    <label>Estado de vacante</label>
                    <select id="filtroPractica" class="form-control">
                        <option value="">Todos</option>
                        @if (ViewBag.Estados != null)
                        {
                            foreach (var s in ViewBag.Estados as List<SelectListItem>)
                            {
                                <option value="@s.Text">@s.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label>Modalidad</label>
                    <select id="filtroModalidad" class="form-control">
                        <option value="">Todas</option>
                        @if (ViewBag.Modalidades != null)
                        {
                            foreach (var m in ViewBag.Modalidades as List<SelectListItem>)
                            {
                                <option value="@m.Value">@m.Text</option>
                            }
                        }
                    </select>
                </div>
               
            </div>
        </div>
    </div>

    <div class="vacantes-lista"></div>
</section>

<!-- MODAL VISUALIZAR -->
<div class="modal fade" id="modalVisualizar" tabindex="-1" aria-labelledby="modalVisualizarLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; background-color: #F2F2F2; color: #2D594D;">

            <div class="modal-header" style="background-color: #2D594D; color: white;">
                <h5 class="modal-title">Visualizar Vacante</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body px-4">
                <section class="vacante-detalle bg-transparent">
                    <h2 id="vis-Nombre" class="vacante-titulo"></h2>
                    <p class="vacante-empresa"><strong>Empresa:</strong> <span id="vis-Empresa"></span></p>

                    <div class="vacante-info">
                        <p><strong>Descripción:</strong> <span id="vis-Descripcion"></span></p>
                        <p><strong>Requisitos:</strong> <span id="vis-Requisitos"></span></p>
                        <p><strong>Modalidad:</strong> <span id="vis-Modalidad"></span></p>
                        <p><strong>Ubicación:</strong> <span id="vis-Ubicacion"></span></p>
                        <p><strong>Fecha límite de aplicación:</strong> <span id="vis-FechaAplicacion"></span></p>
                    </div>

                    <hr />
                    <h5 class="section-title">Información de Contacto</h5>
                    <p><strong>Nombre:</strong> <span id="vis-NombreContacto"></span></p>
                    <p><strong>Teléfonos:</strong> <span id="vis-Telefonos"></span></p>
                    <p><strong>Email(s):</strong> <span id="vis-Emails"></span></p>

                    <hr />
                    <div class="mb-4">
                        <h5 class="section-title">Aplicaciones</h5>

                        <ul class="list-group" id="listaPostulaciones"></ul>

                        <span id="mensajeSinAsignados" class="text-muted" style="display: none;">
                            Ningún estudiante asignado aún
                        </span>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ASIGNAR VACANTE -->
<div class="modal fade" id="modalAsignarVacante" tabindex="-1" aria-labelledby="modalAsignarVacanteLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; background-color: #F2F2F2; color: #2D594D;">
            <div class="modal-header" style="background-color: #2D594D; color: white;">
                <h5 class="modal-title">Asignar Estudiantes</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body px-4">
                <div id="mensajeSinEstudiantes" class="alert alert-warning text-center" style="display: none;">
                    No hay estudiantes disponibles para asignar a esta vacante.
                </div>

                <table id="tablaAsignar" class="display responsive nowrap w-100">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th>Nombre</th>
                            <th>Cédula</th>
                            <th>Especialidad</th>
                            <th>Estado Práctica</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
    window.VacantesProfesorCfg = {
      urls: {
        getVacantesProfesor: '@Url.Action("GetVacantesProfesor","Practicas")',
        login: '@Url.Action("Login","Home")',
        detalle: '@Url.Action("Detalle","Practicas")',
        obtenerPostulaciones: '@Url.Action("ObtenerPostulaciones","Practicas")',
        obtenerEstudiantesAsignar: '@Url.Action("ObtenerEstudiantesAsignar","Practicas")',
        asignarEstudiante: '@Url.Action("AsignarEstudiante","Practicas")',
        retirarEstudiante: '@Url.Action("RetirarEstudiante","Practicas")',
            visualizacionPostulacion: '@Url.Action("VisualizacionPostulacion","Practicas")',
         agregarComentario: '/Practicas/AgregarComentario',
      }
    };
    </script>
    <script src="~/Scripts/Practicas/VistaVacantesProfesor.js?v=@DateTime.Now.Ticks"></script>
}
