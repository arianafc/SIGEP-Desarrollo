@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewBag.Title = "Listado de Egresados";
    var idRol = Session["IdRol"] != null ? Convert.ToInt32(Session["IdRol"]) : 0; // 1=Est, 2=Coord, 3=Prof, 4=Egr
}

<h2 class="vacantes-titulo titulo-principal d-flex justify-content-center align-items-center">
    Listado de Egresados
</h2>

<!-- Filtros -->
<div class="vacantes-titulo titulo-principal d-flex justify-content-between mb-3 align-items-center">
    <div class="dropdown">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filtroDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-filter"></i> Filtros
        </button>
        <div class="dropdown-menu p-3" style="min-width: 300px;">
            <div class="mb-2">
                <label>Especialidad</label>
                <select id="ddlEspecialidad" class="form-control">
                    <option value="">Todas</option>
                    @foreach (var esp in ViewBag.Especialidades as List<SelectListItem>)
                    {
                        <option value="@esp.Value">@esp.Text</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label>Año de Generación</label>
                <select id="ddlAnio" class="form-control">
                    <option value="0">Todos</option>
                    @foreach (var anio in ViewBag.Anios as List<SelectListItem>)
                    {
                        <option value="@anio.Value">@anio.Text</option>
                    }
                </select>
            </div>
            <div>
                <button id="btnBuscar" class="btn btn-primary w-100 mt-2">
                    <i class="fa fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla -->
<div class="card rounded-5 p-3">
    <table id="tblEgresados" class="display responsive nowrap w-100">
        <thead>
            <tr>
                <th>Nombre Completo</th>
                <th>Generación</th>
                <th>Especialidad</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<!-- Modal Detalle -->
<div class="modal fade" id="modalDetalleEgresado" tabindex="-1" aria-labelledby="modalDetalleEgresadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" style="border-radius: 12px; background-color: #F2F2F2; color: #2D594D;">
            <div class="modal-header" style="background-color: #2D594D; color: white;">
                <h5 class="modal-title"><i class="fa fa-id-card"></i> Detalle del Egresado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
                <div id="detalleContenido"></div>
            </div>
            <div class="modal-footer px-4">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Egresados/ListaEgresados.js"></script>
}
