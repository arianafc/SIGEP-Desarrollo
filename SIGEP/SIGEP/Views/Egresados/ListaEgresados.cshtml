@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewBag.Title = "Listado de Egresados";
    var idRol = Session["IdRol"] != null ? Convert.ToInt32(Session["IdRol"]) : 0; // 1=Est, 2=Coord, 3=Prof, 4=Egr
}

@section styles {
    <link href="~/Content/ListaEgresados.css" rel="stylesheet" />
}

@if (idRol == 2)
{
    <h2 class="vacantes-titulo titulo-principal text-center mb-4">
        Listado de Egresados
    </h2>

    <!-- Filtros con estilo uniforme -->
    <div class="d-flex justify-content-between mb-3 align-items-center">
        <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filtroDropdown"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-filter"></i> Filtros
            </button>
            <div class="dropdown-menu p-3" style="min-width: 300px;">
                <div class="mb-2">
                    <label>Especialidad</label>
                    <select id="ddlEspecialidad" class="form-control">
                        <option value="">Todas</option>
                        @foreach (var esp in ViewBag.Especialidades as List<SelectListItem>)
                        {
                            <option value="@esp.Value">@esp.Text</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label>Año de Generación</label>
                    <select id="ddlAnio" class="form-control">
                        <option value="0">Todos</option>
                        @foreach (var anio in ViewBag.Anios as List<SelectListItem>)
                        {
                            <option value="@anio.Value">@anio.Text</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card rounded-5 p-3">
        <table id="miTabla" class="display responsive nowrap w-100">
            <thead>
                <tr>
                    <th></th>
                    <th>Nombre Completo</th>
                    <th>Generación</th>
                    <th>Especialidad</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    @section Scripts {
        <script src="~/Scripts/Egresados/ListaEgresados.js?v=@DateTime.Now.Ticks"></script>
    }
}
else
{
    <div class="alert alert-danger text-center mt-5">
        <h4>No tiene permisos para acceder a esta sección.</h4>
    </div>
}
