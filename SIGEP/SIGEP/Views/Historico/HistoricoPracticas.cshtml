@model IEnumerable<dynamic>

@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewBag.Title = "Histórico de Prácticas";
}

@section styles {
    <link href="~/Content/estilos/AdminGeneral.css" rel="stylesheet" />

    <style>
        .historico-wrapper {
            margin-top: 20px;
        }

        .historico-acciones .btn {
            border-radius: 20px;
            padding: 12px;
            font-weight: 600;
        }

        .table th {
            font-weight: bold !important;
        }

        @@media print {
            .historico-acciones,
            nav,
            .navbar,
            footer,
            #tablaHistorico_filter,
            #tablaHistorico_paginate {
                display: none !important;
            }

            body {
                background: #ffffff !important;
            }

            .card {
                box-shadow: none !important;
            }
        }
    </style>
}

<section class="container historico-wrapper">

    <h2 class="vacantes-titulo titulo-principal text-center mb-4">Histórico de Prácticas</h2>

    <div class="row historico-acciones mb-4">
        <div class="col-md-6 mb-2">
            <button type="button"
                    class="btn btn-outline-secondary w-100"
                    onclick="window.print()">
                <i class="bi bi-file-earmark-pdf me-2"></i> Imprimir / Guardar PDF
            </button>
        </div>

        <div class="col-md-6 mb-2">
            <a href="@Url.Action("ExportarExcel", "Historico")"
               class="btn btn-outline-success w-100">
                <i class="bi bi-file-earmark-excel me-2"></i> Descargar Excel
            </a>
        </div>
    </div>

    <div class="card rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
            <table id="tablaHistorico" class="display nowrap w-100">
                <thead>
                    <tr>
                        <th>Estudiante</th>
                        <th>Especialidad</th>
                        <th>Vacante</th>
                        <th>Modalidad</th>
                        <th>Tipo</th>
                        <th>Fecha Aplicación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td>@x.NombreCompleto</td>
                            <td>@x.Especialidad</td>
                            <td>@x.NombreVacante</td>
                            <td>@x.Modalidad</td>
                            <td>@x.Tipo</td>
                            <td>@x.FechaAplicacion.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-link text-decoration-none ver-detalle-practica"
                                        data-idusuario="@x.IdUsuario"
                                        data-idvacante="@x.IdVacante"
                                        title="Ver detalles de la práctica">
                                    <i class="bi bi-eye fs-5 text-secondary"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- MODAL CON OPCIONES EN CARDS -->
<div class="modal fade" id="modalComentarios" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header rounded-top-4" style="background-color:#2D594D;color:#fff;">
                <h5 class="modal-title">
                    <i class="bi bi-eye me-2"></i> Detalle de la práctica
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">

                <!-- OPCIONES (CARDS) -->
                <div id="opcionesDetalle" class="row g-3">
                    <div class="col-md-6">
                        <button type="button" class="btn w-100 h-100 p-0 card-opcion" data-opcion="comentarios">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body d-flex align-items-center">
                                    <i class="bi bi-chat-dots fs-2 me-3 text-secondary"></i>
                                    <div>
                                        <h5 class="mb-1">Comentarios</h5>
                                        <small class="text-muted">
                                            Ver comentarios del tutor y cambios de estado.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </button>
                    </div>

                    <div class="col-md-6">
                        <button type="button" class="btn w-100 h-100 p-0 card-opcion" data-opcion="empresa">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body d-flex align-items-center">
                                    <i class="bi bi-buildings fs-2 me-3 text-secondary"></i>
                                    <div>
                                        <h5 class="mb-1">Empresa / Vacante</h5>
                                        <small class="text-muted">
                                            Ver información de la empresa y la vacante asociada.
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </button>
                    </div>
                </div>

                <!-- SECCIÓN COMENTARIOS -->
                <div id="seccionComentarios" class="mt-3 d-none">
                    <h5 class="mb-3">
                        <i class="bi bi-chat-dots me-2"></i> Comentarios
                    </h5>

                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Comentario</th>
                                <th>Autor</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyComentarios">
                        </tbody>
                    </table>
                    <div id="sinComentarios" class="text-center text-muted d-none">
                        No hay comentarios registrados para este estudiante.
                    </div>
                </div>

                <!-- SECCIÓN EMPRESA / VACANTE -->
                <div id="seccionEmpresa" class="mt-3 d-none">
                    <h5 class="mb-3">
                        <i class="bi bi-buildings me-2"></i> Empresa y Vacante
                    </h5>

                    <div id="detalleEmpresaContenido">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold">Vacante</h6>
                                <p class="mb-1"><strong>Nombre:</strong> <span id="vacanteNombre"></span></p>
                                <p class="mb-1"><strong>Tipo / Modalidad:</strong> <span id="vacanteModalidad"></span></p>
                                <p class="mb-1"><strong>Fecha máx. aplicación:</strong> <span id="vacanteFechaMax"></span></p>
                                <p class="mb-1"><strong>Requerimientos:</strong></p>
                                <p id="vacanteRequerimientos" class="mb-2"></p>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold">Empresa</h6>
                                <p class="mb-1"><strong>Nombre:</strong> <span id="empresaNombre"></span></p>
                                <p class="mb-1"><strong>Contacto:</strong> <span id="empresaContacto"></span></p>
                                <p class="mb-1"><strong>Correo contacto:</strong> <span id="empresaCorreo"></span></p>
                                <p class="mb-1"><strong>Teléfono contacto:</strong> <span id="empresaTelefono"></span></p>
                            </div>
                        </div>

                        <hr />

                        
                    </div>

                    <div id="sinEmpresa" class="text-center text-muted d-none">
                        No se encontró información de la empresa/vacante para esta práctica.
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <!-- Nota: quitamos data-bs-dismiss y lo manejamos por JS -->
                <button type="button" class="btn CerrarModal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            if ($.fn.DataTable) {
                $('#tablaHistorico').DataTable({
                    responsive: true,
                    language: {
                        url: "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
                    },
                    // Ordenar por Fecha Aplicación (columna 5 - índice base 0)
                    order: [[5, "desc"]]
                });
            }

            // Al hacer clic en el ojo
            $(document).on('click', '.ver-detalle-practica', function () {
                var idUsuario = $(this).data('idusuario');
                var idVacante = $(this).data('idvacante');

                var $modal = $('#modalComentarios');
                $modal.data('idusuario', idUsuario);
                $modal.data('idvacante', idVacante);

                // Mostrar opciones y ocultar secciones
                $('#opcionesDetalle').removeClass('d-none');
                $('#seccionComentarios').addClass('d-none');
                $('#seccionEmpresa').addClass('d-none');

                // Limpiar contenidos anteriores
                $('#tbodyComentarios').empty();
                $('#sinComentarios').addClass('d-none');

                $('#vacanteNombre').text('');
                $('#vacanteModalidad').text('');
                $('#vacanteFechaMax').text('');
                $('#vacanteRequerimientos').text('');

                $('#empresaNombre').text('');
                $('#empresaContacto').text('');
                $('#empresaCorreo').text('');
                $('#empresaTelefono').text('');

                $('#estNombre').text('');
                $('#estCedula').text('');
                $('#estEdad').text('');
                $('#estEspecialidad').text('');
                $('#estCorreo').text('');

                $('#practicaEstado').text('');
                $('#practicaNota1').text('');
                $('#practicaNota2').text('');
                $('#practicaNotaFinal').text('');

                $('#sinEmpresa').addClass('d-none');

                var modal = new bootstrap.Modal($modal[0]);
                modal.show();
            });

            // Botón Cerrar: si estás en detalles -> volver a opciones; si estás en opciones -> cerrar modal
            $(document).on('click', '.CerrarModal', function () {
                var $modal = $('#modalComentarios');

                if ($('#opcionesDetalle').hasClass('d-none')) {
                    // Estamos en alguna sección de detalle, regresamos a las opciones
                    $('#seccionComentarios').addClass('d-none');
                    $('#seccionEmpresa').addClass('d-none');
                    $('#opcionesDetalle').removeClass('d-none');
                } else {
                    // Ya estamos en las cards, ahora sí cerrar el modal
                    var instance = bootstrap.Modal.getInstance($modal[0]);
                    if (instance) {
                        instance.hide();
                    }
                }
            });

            // Click en las cards (Comentarios / Empresa)
            $(document).on('click', '.card-opcion', function () {
                var opcion = $(this).data('opcion');
                var $modal = $('#modalComentarios');
                var idUsuario = $modal.data('idusuario');
                var idVacante = $modal.data('idvacante');

                if (opcion === 'comentarios') {
                    $('#opcionesDetalle').addClass('d-none');
                    $('#seccionEmpresa').addClass('d-none');
                    $('#seccionComentarios').removeClass('d-none');

                    $('#tbodyComentarios').empty();
                    $('#sinComentarios').addClass('d-none');

                    $.getJSON('@Url.Action("ObtenerComentarios", "Historico")',
                        { idUsuario: idUsuario },
                        function (data) {
                            if (data && data.length > 0) {
                                $.each(data, function (i, c) {
                                    var fila = '<tr>' +
                                        '<td>' + c.comentario + '</td>' +
                                        '<td>' + c.autor + '</td>' +
                                        '<td>' + c.fecha + '</td>' +
                                        '</tr>';
                                    $('#tbodyComentarios').append(fila);
                                });
                            } else {
                                $('#sinComentarios').removeClass('d-none');
                            }
                        });
                }
                else if (opcion === 'empresa') {
                    $('#opcionesDetalle').addClass('d-none');
                    $('#seccionComentarios').addClass('d-none');
                    $('#seccionEmpresa').removeClass('d-none');

                    $('#sinEmpresa').addClass('d-none');

                    $.getJSON('@Url.Action("ObtenerDetallePractica", "Historico")',
                        { idVacante: idVacante, idUsuario: idUsuario },
                        function (data) {
                            if (!data) {
                                $('#sinEmpresa').removeClass('d-none');
                                return;
                            }

                            $('#vacanteNombre').text(data.vacante || '');
                            $('#vacanteModalidad').text(data.modalidad || '');
                            $('#vacanteFechaMax').text(data.fechaMaxAplicacion || '');
                            $('#vacanteRequerimientos').text(data.requerimientos || '');

                            $('#empresaNombre').text(data.empresa || '');
                            $('#empresaContacto').text(data.contactoNombre || '');
                            $('#empresaCorreo').text(data.contactoCorreo || '');
                            $('#empresaTelefono').text(data.contactoTelefono || '');

                            $('#estNombre').text(data.estudiante || '');
                            $('#estCedula').text(data.cedulaEstudiante || '');
                            $('#estEdad').text(data.edadEstudiante || '');
                            $('#estEspecialidad').text(data.especialidadEstudiante || '');
                            $('#estCorreo').text(data.correoEstudiante || '');

                            $('#practicaEstado').text(data.estadoPractica || '');
                            $('#practicaNota1').text(
                                data.nota1 !== null && data.nota1 !== undefined ? data.nota1 : '—'
                            );
                            $('#practicaNota2').text(
                                data.nota2 !== null && data.nota2 !== undefined ? data.nota2 : '—'
                            );
                            $('#practicaNotaFinal').text(
                                data.notaFinal !== null && data.notaFinal !== undefined ? data.notaFinal : '—'
                            );
                        });
                }
            });
        });
    </script>
}
